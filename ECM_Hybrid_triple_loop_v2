> # ============================================================
> # PART 2 — FORMULA DEFINITIONS
> # ============================================================
> dlnk_s_vars  <- paste(paste0("dlnk_s",  1:21), collapse = " + ")
> dlnva_s_vars <- paste(paste0("dlnva_s", 1:21), collapse = " + ")
> 
> formula_y <- as.formula(paste(
+   "lnl ~ factor(code) + jaar + dlnk + dlnva +",
+   dlnk_s_vars, "+", dlnva_s_vars
+ ))
> 
> formula_va <- as.formula(paste(
+   "lnva ~ factor(sectorsbi08) + dlnk + dlnva +",
+   dlnva_s_vars, "+", dlnk_s_vars
+ ))
> 
> formula_k <- as.formula(paste(
+   "lnk ~ factor(sectorsbi08) + dlnk + dlnva +",
+   dlnk_s_vars, "+", dlnva_s_vars
+ ))
> 
> formula_ec2 <- ec_term ~ error_va +
+   error_va:factor(sectorsbi08) +
+   error_k  +
+   error_k:factor(sectorsbi08)
> 
> # Simplified ECM: d_error_va / d_error_k removed to save degrees of freedom
> ecm_formula <- dlnl ~ dlnl_lag + ec_term_lag + dlnva + dlnk
> 
> # ============================================================
> # PART 4 — THREE-LEVEL SDOLS + ECM FORECASTING LOOP
> # ============================================================
> df_pred_all   <- data.frame()
> segments_loop <- unique(df_full$segment)
> 
> # ── OUTER LOOP: segments ─────────────────────────────────────
> for (seg in segments_loop) {
+   
+   df_seg       <- df_full %>% filter(segment == seg)
+   df_seg_train <- df_seg  %>% filter(!is.na(lnl))
+   df_seg_fore  <- df_seg  %>% filter(is.na(lnl))
+   df_pred_seg  <- data.frame()
+   
+   if (nrow(df_seg_train) < 10 || nrow(df_seg_fore) == 0) {
+     rm(df_seg, df_seg_train, df_seg_fore)
+     next
+   }
+   
+   # ══════════════════════════════════════════════════════════
+   # SDOLS STEP 1 — segment level
+   # ══════════════════════════════════════════════════════════
+   step1_y  <- lm(formula_y,  data = df_seg_train)
+   step1_va <- lm(formula_va, data = df_seg_train)
+   step1_k  <- lm(formula_k,  data = df_seg_train)
+   
+   df_seg_train$y_1      <- predict(step1_y,  newdata = df_seg_train)
+   df_seg_train$error_va <- df_seg_train$lnva - predict(step1_va, newdata = df_seg_train)
+   df_seg_train$error_k  <- df_seg_train$lnk  - predict(step1_k,  newdata = df_seg_train)
+   df_seg_train$ec_term  <- df_seg_train$lnl  - df_seg_train$y_1
+   
+   suppressWarnings({
+     df_seg_fore$error_va <- df_seg_fore$lnva - predict(step1_va, newdata = df_seg_fore)
+     df_seg_fore$error_k  <- df_seg_fore$lnk  - predict(step1_k,  newdata = df_seg_fore)
+   })
+   
+   # ══════════════════════════════════════════════════════════
+   # SDOLS STEP 2 — segment level
+   # ══════════════════════════════════════════════════════════
+   step2_ec <- lm(formula_ec2, data = df_seg_train)
+   
+   df_seg_train$err_y_hat <- pmax(pmin(
+     predict(step2_ec, newdata = df_seg_train), 1.5), -1.5)
+   
+   df_seg_train$lnlhat  <- df_seg_train$y_1 + df_seg_train$err_y_hat
+   df_seg_train$ec_term2 <- df_seg_train$lnl - df_seg_train$lnlhat
+   
+   # ── Lags and differences for ECM ─────────────────────────
+   df_seg_train <- df_seg_train %>%
+     arrange(code, jaar) %>%
+     group_by(code) %>%
+     mutate(
+       ec_term_lag  = lag(ec_term2),
+       error_va_lag = lag(error_va),
+       error_k_lag  = lag(error_k),
+       d_error_va   = error_va - error_va_lag,
+       d_error_k    = error_k  - error_k_lag,
+       dlnl_lag     = lag(dlnl)
+     ) %>%
+     ungroup()
+   
+   temp_sectors <- unique(df_seg$sector)
+   
+   # ── MIDDLE LOOP: sectors ───────────────────────────────────
+   for (sec in temp_sectors) {
+     
+     df_sec_train <- df_seg_train %>% filter(sector == sec)
+     df_sec_fore  <- df_seg_fore  %>% filter(sector == sec)
+     codes        <- unique(df_sec_train$code)
+     
+     if (nrow(df_sec_train) < 5 || nrow(df_sec_fore) == 0) {
+       rm(df_sec_train, df_sec_fore, codes)
+       next
+     }
+     
+     # ── Stability check (diagnostic only) ───────────────────
+     for (cd in codes) {
+       df_sub <- df_sec_train %>%
+         filter(code == cd, !is.na(ec_term_lag), !is.na(dlnl_lag))
+       m <- lm(ecm_formula, data = df_sub)
+       g <- coef(m)["ec_term_lag"]
+       if (any(is.na(coef(m))))
+         cat("NA coef  - seg:", seg, "sec:", sec, "code:", cd, "\n")
+       if (!is.na(g) && (g >= 0 | g <= -1))
+         cat("Unstable - seg:", seg, "sec:", sec, "code:", cd,
+             "| gamma =", round(g, 3), "\n")
+       rm(df_sub, m, g)
+     }
+     
+     results_list <- list()
+     
+     # ── INNER LOOP: codes ──────────────────────────────────
+     for (cd in codes) {
+       
+       df_sub_train <- df_sec_train[df_sec_train$code == cd, ]
+       df_sub_fore  <- df_sec_fore[df_sec_fore$code   == cd, ]
+       
+       if (nrow(df_sub_fore) == 0) next
+       
+       df_ecm_train <- df_sub_train %>%
+         filter(!is.na(ec_term_lag), !is.na(dlnl_lag))
+       
+       model_cd <- lm(ecm_formula, data = df_ecm_train)
+       cf       <- coef(model_cd)
+       gamma    <- cf["ec_term_lag"]
+       
+       # ── Skip if NA coefs ────────────────────────────────
+       if (any(is.na(cf))) {
+         warning(paste("Skipping", cd, "- NA coefs"))
+         rm(df_sub_train, df_sub_fore, df_ecm_train, model_cd, cf)
+         next
+       }
+       
+       # ── Skip if gamma outside (-1, 0) ───────────────────
+       if (is.na(gamma) || gamma >= 0 || gamma <= -1) {
+         warning(paste("Skipping", cd, "- unstable gamma =", round(gamma, 3)))
+         rm(df_sub_train, df_sub_fore, df_ecm_train, model_cd, cf)
+         next
+       }
+       
+       # ── Extract coefficients (single estimation) ────────
+       alpha      <- cf["(Intercept)"]
+       b_dlnl_lag <- cf["dlnl_lag"]
+       gamma      <- max(min(gamma, -0.05), -0.95)   # clamp to stable range
+       b_dlnva    <- cf["dlnva"]
+       b_dlnk     <- cf["dlnk"]
+       
+       # ── Anchor scalars from last training year ───────────
+       anchor        <- df_sub_train[df_sub_train$jaar == max(df_sub_train$jaar), ]
+       lnl_prev      <- anchor$lnl
+       dlnl_prev     <- anchor$dlnl
+       error_va_prev <- anchor$error_va
+       error_k_prev  <- anchor$error_k
+       ec_prev       <- max(min(anchor$ec_term2, 1.5), -1.5)
+       
+       df_sub_fore <- df_sub_fore %>% arrange(jaar)
+       df_sub_fore$pred_dlnl <- NA_real_
+       df_sub_fore$lnl       <- NA_real_
+       
+       # ── Year-by-year scalar forecast ─────────────────────
+       for (i in seq_len(nrow(df_sub_fore))) {
+         
+         row           <- df_sub_fore[i, ]
+         error_va_curr <- row$error_va
+         error_k_curr  <- row$error_k
+         
+         pred_dlnl <- alpha +
+           b_dlnl_lag * dlnl_prev +
+           gamma      * ec_prev +
+           b_dlnva    * row$dlnva +
+           b_dlnk     * row$dlnk
+         
+         lnl_curr <- lnl_prev + pred_dlnl
+         
+         df_sub_fore$pred_dlnl[i] <- pred_dlnl
+         df_sub_fore$lnl[i]       <- lnl_curr
+         
+         # Update scalars for next year
+         lnl_prev      <- lnl_curr
+         dlnl_prev     <- pred_dlnl
+         error_va_prev <- error_va_curr
+         error_k_prev  <- error_k_curr
+         
+         # ec_prev: clamp jaar to avoid new-level error in step1_y
+         row_pred        <- row
+         row_pred$jaar   <- as.integer(data_end)
+         suppressWarnings({
+           ec_raw  <- lnl_curr - predict(step1_y,  newdata = row_pred)
+           ec_prev <- ec_raw   - predict(step2_ec, newdata = data.frame(
+             error_va    = error_va_curr,
+             error_k     = error_k_curr,
+             sectorsbi08 = row$sectorsbi08
+           ))
+         })
+         ec_prev <- max(min(ec_prev, 1.5), -1.5)
+         
+       } # end year loop
+       
+       # ── Jensen correction + back-transform ───────────────
+       sigma2                    <- summary(model_cd)$sigma^2
+       df_sub_fore$lnl_corrected <- df_sub_fore$lnl + sigma2 / 2
+       df_sub_fore$L_forecast    <- exp(df_sub_fore$lnl_corrected)
+       
+       results_list[[as.character(cd)]] <- df_sub_fore
+       
+       rm(df_sub_train, df_sub_fore, df_ecm_train, model_cd, cf, anchor, sigma2)
+       
+     } # end inner loop (codes)
+     
+     if (length(results_list) > 0) {
+       df_pred_seg <- bind_rows(df_pred_seg, bind_rows(results_list))
+     }
+     
+     rm(df_sec_train, df_sec_fore, codes, results_list)
+     
+   } # end middle loop (sectors)
+   
+   df_pred_all <- bind_rows(df_pred_all, df_pred_seg)
+   
+   rm(df_seg, df_seg_train, df_seg_fore,
+      step1_y, step1_va, step1_k,
+      step2_ec, df_pred_seg, temp_sectors)
+   
+ } # end outer loop (segments)
